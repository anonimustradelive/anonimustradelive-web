Options -Indexes

# Las imágenes subidas nunca deben poder ejecutarse como script, aunque ya
# validamos el contenido real en index.php (defensa en profundidad).
<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
